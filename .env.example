# =============================================================================
# Moorchid · backend environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Default: local SQLite file at the project root.
# For production, point to a managed Postgres URL and switch the SQLAlchemy
# engine in models.py accordingly. Schema is portable.
DATABASE_URL=sqlite:///./soulcontext_journal.db

# ── Auth (REQUIRED in production) ─────────────────────────────────────────────
# Generate a strong secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Both names are accepted for backward compatibility; JWT_SECRET_KEY is the
# canonical name.
JWT_SECRET_KEY=replace-me-with-a-64-char-hex-string-from-secrets-token_hex
# JWT_SECRET=legacy-alias

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of exact origins allowed to call the API.
# Frontend dev:    http://localhost:5173
# Frontend preview:http://localhost:4173
# Production:      https://moorchid.your-domain.com
# Use "*" ONLY if you also set allow_credentials=False — browsers will reject
# credentials-mode requests with a wildcard origin anyway.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ── DeepSeek API (required) ───────────────────────────────────────────────────
# Pattern extraction / Soul Chat / Poet generation
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENABLED=true
DEEPSEEK_TIMEOUT_SECONDS=30

# ── ZhipuAI API (optional) ────────────────────────────────────────────────────
# Embeddings; empty / unset falls back to deterministic hash vectors.
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=embedding-3
ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_ENABLED=false
ZHIPUAI_TIMEOUT_SECONDS=15

# ── Vector store ──────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma
VECTOR_DIMENSION=1024
VECTOR_TOP_K=5
CHROMA_PERSIST_DIR=./data/chroma
VECTOR_COLLECTION_NAME=soulcontext_memory

# ── Misc ──────────────────────────────────────────────────────────────────────
# Allow demo / hash fallback if upstream APIs are unavailable. Safe to leave on.
ALLOW_DEMO_FALLBACK=true